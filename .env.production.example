# Exemplo de variáveis para produção (VPS no Brasil, domínio .com.br).
# Copie para .env no servidor e ajuste os valores. Nunca versione o .env real.

APP_NAME=PIB
APP_ENV=production
APP_KEY=            # gere com: php artisan key:generate
APP_DEBUG=false
APP_URL=https://portalinvestbahia.com.br

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt

# Log em produção não deve ficar em nível "debug" (evita vazar detalhes
# internos/stack traces nos arquivos de log).
LOG_LEVEL=error

# Cookie de sessão só é enviado sobre HTTPS (o site roda atrás de TLS).
SESSION_SECURE_COOKIE=true

# Necessário se houver um proxy reverso/TLS na frente (recomendado no deploy):
# sem isso, o Laravel pode detectar o esquema/IP errado do visitante.
# Use o IP do proxy, ou "*" se ele já for confiável (rede interna do compose).
TRUSTED_PROXIES=*

# Banco (o host "pgsql" é o nome do serviço no compose de produção).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pib
DB_USERNAME=pib
DB_PASSWORD=troque-esta-senha

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail (para notificações internas do painel, se necessário).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contato@portalinvestbahia.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem dos uploads (disco público, volume persistente no servidor).
FILESYSTEM_DISK=public

# Credenciais do db:seed (admin geral + corretor de exemplo). OBRIGATÓRIO
# definir com senhas próprias antes de rodar o seeder em produção — o
# seeder recusa rodar com a senha padrão de desenvolvimento ("password").
PIB_ADMIN_EMAIL=admin@portalinvestbahia.com.br
PIB_ADMIN_PASSWORD=troque-esta-senha-tambem
PIB_BROKER_EMAIL=
PIB_BROKER_PASSWORD=
